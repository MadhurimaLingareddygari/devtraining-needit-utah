        <http_method>GET</http_method>
        <name>ni_getinfo</name>
        <operation_script><![CDATA[(function process(/*RESTAPIRequest*/ request, /*RESTAPIResponse*/ response) {

    var requestUser=request.pathParams.user_name;
	var array=[];
	var count=0;
	var count1=0;
	var querycode=request.queryParams.ni_query;
	var user=new GlideRecord('sys_user');
	user.get("user_name",requestUser);
	var need= new GlideAggregate("x_58872_needit_needit");
	need.addAggregate("COUNT");
	need.addQuery("u_requested_for",user.sys_id);
	need.addEncodedQuery(querycode);
	need.groupBy("u_request_type");
	need.query();
	while(need.next()){
		count=need.getAggregate("COUNT");
		array.push({"request type": need.u_request_type.getDisplayValue(),"Count":count});
		count1=count1+parseInt(count);
	}
	var body={};
	body.c=count1;
	body.cat=array;
	body.user1={"username":user.user_name,"userid":user.sys_id};
	response.setBody(body);

	
	

})(request, response);]]></operation_script>
